{
  "name": "Express and Vite dev",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:26",
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.1": {
      "pnpmVersion": "latest"
    }
  },
  "forwardPorts": [3000, 5173],
  "postCreateCommand": "pnpm install && mkdir -p ~/.codex && cp /tmp/codex-auth.json ~/.codex/auth.json",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "christian-kohler.path-intellisense",
        "humao.rest-client",
        "formulahendry.auto-rename-tag"
      ]
    }
  },
  "mounts": [
    "source=${env:HOME}/.codex/auth.json,target=/tmp/codex-auth.json,type=bind"
  ]
}