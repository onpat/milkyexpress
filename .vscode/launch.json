{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Vite",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/milky-react/node_modules/vite/bin/vite.js",
      "cwd": "${workspaceFolder}/milky-react",
      "console": "integratedTerminal",
      "killBehavior": "forceful",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug Express",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/tsx/dist/cli.mjs",
      "args": ["watch", "src/app.ts"],
      "cwd": "${workspaceFolder}/milky-express",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "killBehavior": "forceful",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Debug milkyexpress",
      "configurations": ["Debug Vite", "Debug Express"],
      "stopAll": true
    }
  ]
}
